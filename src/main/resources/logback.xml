<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_ENCODING" value="UTF-8"/>
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_FILENAME" value="application.log"/>
    <property name="LOG_FILE_PATTERN" value="application.%d{yyyy-MM-dd}.%i.log"/>

    <property name="APP_LOG_LEVEL" value="INFO"/>
    <property name="ROOT_LOG_LEVEL" value="WARN"/>
    <property name="THIRD_PARTY_LOG_LEVEL" value="WARN"/>

    <property name="MAX_FILE_SIZE" value="10MB"/>
    <property name="MAX_HISTORY" value="7"/>
    <property name="TOTAL_SIZE_CAP" value="100MB"/>

    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%-40.40logger{30}) - %msg%n"/>
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-40.40logger{30} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <immediateFlush>true</immediateFlush>
        <encoder>
            <charset>${LOG_ENCODING:-UTF-8}</charset>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILENAME}</file>
        <immediateFlush>true</immediateFlush>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${LOG_FILE_PATTERN}</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE:-10MB}</maxFileSize>
            <maxHistory>${MAX_HISTORY:-7}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP:-100MB}</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <charset>${LOG_ENCODING:-UTF-8}</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="org.slf4j" level="${THIRD_PARTY_LOG_LEVEL:-WARN}"/>
    <logger name="ch.qos.logback" level="${THIRD_PARTY_LOG_LEVEL:-WARN}"/>

    <logger name="ru.shift" level="${APP_LOG_LEVEL:-DEBUG}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <root level="${ROOT_LOG_LEVEL:-WARN}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>